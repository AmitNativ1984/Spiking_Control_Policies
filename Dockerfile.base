FROM nvcr.io/nvidia/pytorch:22.12-py3 AS base


ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1



# System deps for: build tools + X11/GL/Vulkan + headless X (xvfb)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    wget \
    unzip \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    libgl1 \
    libegl1 \
    libglvnd0 \
    libglvnd-dev \
    libx11-6 \
    libxext6 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxinerama1 \
    libxcursor1 \
    libxxf86vm1 \
    libsm6 \
    libglib2.0-0 \
    libvulkan1 \
    vulkan-tools \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# WAR for eglReleaseThread shutdown crash in libEGL_mesa.so.0
# Prevents Mesa's EGL from being loaded, forcing NVIDIA's EGL
RUN rm -f /usr/lib/x86_64-linux-gnu/libEGL_mesa.so.0 \
           /usr/lib/x86_64-linux-gnu/libEGL_mesa.so.0.0.0 \
           /usr/share/glvnd/egl_vendor.d/50_mesa.json

FROM base AS isaacgym    

# Isaac Gym
COPY isaacgym /opt/isaacgym
ENV ISAACGYM_PATH=/opt/isaacgym \
    PYTHONPATH=/opt/isaacgym/python:${PYTHONPATH}

# Install NVIDIA vendor configs for EGL and Vulkan
COPY isaacgym/docker/10_nvidia.json /usr/share/glvnd/egl_vendor.d/10_nvidia.json
COPY isaacgym/docker/nvidia_icd.json /usr/share/vulkan/icd.d/nvidia_icd.json

    # Install Isaac Gym python package
RUN python -m pip install --no-cache-dir -U pip setuptools wheel && \
    python -m pip install --no-cache-dir -e /opt/isaacgym/python


FROM isaacgym AS aerial_gym

# Our fork of ntnu-arl/aerial_gym_simulator, carrying three fixes that the upstream
# main branch does not have yet (see the branch's single commit for measurements):
#
#   1. warp BVHs were built over a ZERO-FILLED vertex buffer, so every acceleration
#      structure was degenerate for the whole run  (~95x on a 64-env step)
#   2. reset_idx refit() the BVH where a rebuild is needed, making render cost LINEAR
#      in obstacle count  (173x at ~5 obstacles/env, 342x at ~27)
#   3. asset placement was skipped entirely at num_obstacles == 0, which also skipped
#      PARKING unused assets -- leaving the whole pool stacked at the world origin,
#      inside the arena, making one goal direction unreachable
#
# Depth output is unchanged: refit vs rebuild renders are identical to 0.0 max abs
# difference over 3,686,400 pixels.
#
# Once these land upstream, point this back at ntnu-arl and drop the corresponding
# monkeypatches in env_manager/*_patch.py.
ARG AERIAL_GYM_REPO=https://github.com/AmitNativ1984/aerial_gym_simulator.git
ARG AERIAL_GYM_REF=fix/warp-bvh-and-asset-placement

WORKDIR /app/aerial_gym
RUN git clone --recursive ${AERIAL_GYM_REPO} aerial_gym_simulator && \
    cd aerial_gym_simulator && \
    git checkout ${AERIAL_GYM_REF}

WORKDIR /app/aerial_gym/aerial_gym_simulator

RUN pip install -e .

# Pin rl-games: aerial_gym_simulator's setup.py leaves it unversioned, so a
# rebuild can silently pick up a newer release. 1.6.5 turns on torch.compile
# by default (no opt-out in our yaml configs), which tanks training throughput
# (observed: ~18-20 fps vs. the expected thousands, and 30-65+ min with no
# epoch output at num_envs=512/1024). All runs before the 2026-08-28 rebuild
# used 1.6.1, which has no torch.compile at all -- pin back to that.
RUN pip install --no-cache-dir rl-games==1.6.1

# Fix OpenCV version incompatibility (cv2.dnn.DictValue issue)
RUN pip uninstall -y opencv-python opencv-python-headless opencv-contrib-python || true && \
    pip install --no-cache-dir opencv-python==4.5.5.64

# Replace urdfpy with urchin, its maintained fork.
#
# urdfpy 0.0.22 is the final release (project abandoned) and its Cylinder.meshes is
# broken two ways: _meshes initialises to None instead of [] (so len() raises
# "object of type 'NoneType' has no len()") and it returns self._mesh instead of
# self._meshes. Box and Sphere are both correct. The result is that EVERY urdf using
# a <cylinder> primitive fails urdfpy's visual_trimesh_fk(), which is the code path
# aerial_gym/assets/warp_asset.py takes -- killing all 100 tree assets (26 cylinders
# each) and the cylinder obstacles. With use_warp=True the env dies before the sim is
# built, and the traceback points at asset loading rather than at urdfpy.
# urchin fixes both bugs and also drops the deprecated np.float usage.
#
# --no-deps is deliberate: urchin requires pyribbit (a pyrender fork), which would drag
# a GL stack into an image that intentionally removes Mesa EGL above. The parser only
# needs lxml/networkx/numpy/trimesh/six, all already present; pycollada is unnecessary
# because none of the bundled assets are .dae.
#
# aerial_gym hardcodes `from urdfpy import URDF`, so a shim module keeps upstream
# untouched and fixes every consumer of urdfpy at once.
RUN pip uninstall -y urdfpy && \
    pip install --no-cache-dir --no-deps urchin==0.0.29 && \
    printf '%s\n' \
      '"""Shim: urdfpy is abandoned; redirect to the maintained fork urchin."""' \
      'from urchin import *  # noqa: F401,F403' \
      'from urchin import URDF, Box, Cylinder, Sphere, Mesh, Geometry  # noqa: F401' \
      'from urchin.utils import (  # noqa: F401' \
      '    rpy_to_matrix, matrix_to_rpy, xyz_rpy_to_matrix, matrix_to_xyz_rpy,' \
      ')' \
      > /usr/local/lib/python3.8/dist-packages/urdfpy.py

FROM aerial_gym AS dev

# wandb pulls typing_extensions>=4.8 but bounds pydantic only as <3, so pip leaves
# the base image's pydantic 1.10.2 behind — a pair that cannot import wandb at all.
# spacy/confection cap pydantic <1.11, so this window is the only one that resolves.
RUN pip install \
    loguru \
    wandb \
    "pydantic>=1.10.8,<1.11"

# snntorch 0.9.4 fixes the Synaptic.forward bug (self.syn was assigned from mem
# instead of syn in <=0.9.1, corrupting 2nd-order CUBA-LIF dynamics). 0.9.4 tags
# requires_python>=3.9, but it contains no 3.8-incompatible syntax and imports +
# runs cleanly on this image's Python 3.8 (verified), so we bypass the metadata
# gate. --no-deps keeps the NVIDIA-tuned torch in this base image untouched.
RUN pip install --ignore-requires-python --no-deps snntorch==0.9.4

CMD ["bash"]

